# ==============================================================
# PT CEMINDO GEMILANG Tbk – PLANT BATAM
# Meeting Room Management System (MRMS) Environment Config
# ==============================================================

# Application & Network
NODE_ENV=production
PORT=5000
WEB_PORT=8080
APP_BASE_URL=https://cg-plantbatam.com/mrms
API_PREFIX=/mrms/api

# Database (PostgreSQL)
POSTGRES_DB=mrms_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CemindoPlantBatam2026!
DATABASE_URL=postgresql://postgres:CemindoPlantBatam2026!@postgres:5432/mrms_db?schema=public

# Security & Authentication
JWT_SECRET=cemindo-plant-batam-secret-jwt-key-2026-secure
JWT_EXPIRES_IN=7d

# Notifications (mock | production)
# NOTE: Set to 'mock' for local demo. In mock mode, logs are stored in DB
# and viewable in Notification Logs, but no external emails/WA are dispatched.
NOTIFICATION_MODE=mock

# Corporate SMTP Credentials (Production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MRMS PT Cemindo Gemilang Tbk <noreply-mrms@cemindogemilang.com>

# WhatsApp Business API Credentials (Production)
WA_API_URL=https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages
WA_API_TOKEN=
WA_PHONE_NUMBER_ID=

